# Inventaario / Invis — local env template
# Copy to `.env` or `.env.local` (gitignored). Never commit real keys.
#
# Live product photo analysis (Gemini).
EXPO_PUBLIC_GEMINI_API_KEY=
# Preferred for production: GEMINI_API_KEY on the server (/api/vision).
#
# Restart Expo after changing env (`npx expo start`).
#
# Supabase — welcome-gate entries + feedback logging (no passwords).
# Project: Invis — https://supabase.com/dashboard/project/bpazrlmozjrxnrkfrvrq
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# On Vercel, NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY already exist.
# vercel.json maps those into EXPO_PUBLIC_* at build time so the web bundle can log visits.
# Never commit the service_role key.
