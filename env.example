# Inventaario / Invis — local env template
# Copy to `.env` or `.env.local` (gitignored). Never commit real keys.
#
# Live product photo analysis (Gemini).
# Client key (optional — inlined into the web/native bundle):
EXPO_PUBLIC_GEMINI_API_KEY=
# Optional model override (default: gemini-3.6-flash)
# EXPO_PUBLIC_GEMINI_MODEL=gemini-3.6-flash
# Server override for /api/vision: GEMINI_MODEL=gemini-3.6-flash
#
# Preferred for production (Vercel / Netlify): set server-only
#   GEMINI_API_KEY=...
# so /api/vision reads photos without shipping the key to browsers.
# On Vercel dashboard (Production + Preview):
#   GEMINI_API_KEY=<Google AI Studio / Cloud API key>
# Optional: EXPO_PUBLIC_GEMINI_API_KEY (same key) if you also want native/client calls.
# Redeploy after adding env vars — serverless routes read them at runtime;
# EXPO_PUBLIC_* also needs a rebuild to be inlined in the web bundle.
#
# Key restrictions (common prod failure: "GenerateContent are blocked"):
# - Application restrictions = None (Vercel has no stable IPs / referrers)
# - API restrictions = allow Generative Language API (or Don't restrict key)
# - Project must have generativelanguage.googleapis.com Enabled
# Or create a new unrestricted server key in AI Studio and replace GEMINI_API_KEY only.
# Optional absolute proxy URL (defaults to same-origin /api/vision on web):
# EXPO_PUBLIC_VISION_URL=https://invis-lac.vercel.app/api/vision
#
# K-Ruoka full product lookup (photo → name/EAN → live catalog).
# Optional absolute URL to a lookup proxy (defaults to same-origin /api/kruoka-lookup on web).
# EXPO_PUBLIC_KRUOKA_LOOKUP_URL=https://your-app.vercel.app/api/kruoka-lookup
# Optional store id for K-Ruoka prices (default N106).
# EXPO_PUBLIC_KRUOKA_STORE_ID=N106
#
# Restart Expo after changing env (`npx expo start`). EXPO_PUBLIC_* is inlined
# into the client bundle — use a server/Edge proxy for production secrets.
#
# ---------------------------------------------------------------------------
# Multi-venue cloud (Supabase) — required for auth + sync + API quotas
# ---------------------------------------------------------------------------
# Client (Expo):
# EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...   # publishable / anon key only
#
# Server (Vercel / Netlify) — same project; used by /api/vision + /api/kruoka-lookup
# to verify JWTs and enforce per-venue daily limits BEFORE calling Gemini / distributors:
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOi...
# Optional overrides (defaults: vision=100, kruoka-lookup=500, transcribe=50):
# API_LIMIT_VISION=100
# API_LIMIT_KRUOKA_LOOKUP=500
# Force auth even in odd env setups: REQUIRE_API_AUTH=1
# Local-only bypass (never in production): REQUIRE_API_AUTH=0
#
# Apply schema: supabase/migrations/20260824100000_multi_venue_tenancy.sql
# Load test: npm run test:venues
#
