{
  "buildCommand": "EXPO_PUBLIC_SUPABASE_URL=\"${EXPO_PUBLIC_SUPABASE_URL:-$NEXT_PUBLIC_SUPABASE_URL}\" EXPO_PUBLIC_SUPABASE_ANON_KEY=\"${EXPO_PUBLIC_SUPABASE_ANON_KEY:-$NEXT_PUBLIC_SUPABASE_ANON_KEY}\" npx expo export --platform web",
  "outputDirectory": "dist",
  "functions": {
    "api/vision.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/kruoka-lookup.js": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/skaupat-lookup.js": {
      "maxDuration": 15,
      "memory": 256
    },
    "api/transcribe.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/remove-bg.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
